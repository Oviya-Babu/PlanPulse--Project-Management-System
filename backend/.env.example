# Backend Environment Variables
# Copy this file to .env and fill in real values

# Database — PostgreSQL connection string (SECRET)
DATABASE_URL="postgresql://pms:pms_dev_password@localhost:5432/pms_dev?schema=public"

# JWT — Secret key for signing tokens (SECRET, ≥ 32 random bytes)
JWT_SECRET="CHANGE_ME_use_openssl_rand_base64_48"
JWT_EXPIRES_IN="1d"

# Server
PORT=4000
NODE_ENV="development"

# CORS — Comma-separated allowed web origins
CORS_ORIGIN="http://localhost:5173"

# Security
BCRYPT_COST=12
TRUST_PROXY="0"

# Logging
LOG_LEVEL="debug"

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MIN=60

# Test database (SECRET)
TEST_DATABASE_URL="postgresql://pms:pms_dev_password@localhost:5432/pms_test?schema=public"
