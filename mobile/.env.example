# Mobile Environment Configuration

# Option A: Android Emulator (default)
# The Android emulator routes 10.0.2.2 to the host machine's 127.0.0.1
EXPO_PUBLIC_API_BASE_URL="http://10.0.2.2:4000"

# Option B: Physical Device with Expo Go (same Wi-Fi network)
# Replace with your development PC's LAN IP (e.g. 192.168.0.111)
# EXPO_PUBLIC_API_BASE_URL="http://192.168.0.111:4000"
